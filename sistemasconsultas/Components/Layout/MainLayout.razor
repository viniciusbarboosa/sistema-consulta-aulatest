@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager

<AuthorizeView>
    <Authorized>
        @{
            var email = context.User.Identity?.Name ?? "";
            var inicial = email.Length > 0 ? char.ToUpper(email[0]).ToString() : "?";
        }

        <div class="app-root">
            <header class="app-topbar">
                <a href="" class="app-brand">
                    <span class="app-brand-mark"><i class="bi bi-heart-pulse-fill"></i></span>
                    <span>Consultas</span>
                </a>

                <div class="ms-auto d-flex align-items-center gap-2">
                    <button type="button" class="app-icon-btn" onclick="alternarTema()" title="Alternar tema claro e escuro" aria-label="Alternar tema claro e escuro">
                        <i class="bi bi-sun-fill icone-para-claro"></i>
                        <i class="bi bi-moon-stars-fill icone-para-escuro"></i>
                    </button>

                    <button type="button" class="app-icon-btn d-lg-none" @onclick="AlternarMenu" title="Mostrar ou esconder o menu" aria-label="Mostrar ou esconder o menu">
                        <i class="bi bi-list fs-5"></i>
                    </button>

                    <div class="position-relative">
                        <button type="button" class="app-user-btn" @onclick="AlternarMenuUsuario" aria-label="Menu do usuário">
                            <span class="app-avatar">@inicial</span>
                            <span class="app-user-email d-none d-md-inline">@email</span>
                            <i class="bi bi-chevron-down small"></i>
                        </button>

                        @if (menuUsuarioAberto)
                        {
                            <div class="app-menu-backdrop" @onclick="FecharMenuUsuario"></div>

                            <div class="app-user-menu">
                                <div class="app-user-menu-header">
                                    <span class="app-avatar app-avatar-lg">@inicial</span>
                                    <div>
                                        <div class="fw-semibold text-truncate">@email</div>
                                        <small class="text-muted">Usuário</small>
                                    </div>
                                </div>

                                <form action="Account/Logout" method="post">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="ReturnUrl" value="" />
                                    <button type="submit" class="app-user-menu-item">
                                        <i class="bi bi-box-arrow-right me-2"></i>Sair da conta
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </header>

            <div class="app-body @(menuRecolhido ? "menu-recolhido" : "")">
                <NavMenu />

                <main class="app-main">
                    @Body

                    <footer class="app-footer">
                        <span>&copy; 2026 Sistema de Consultas</span>
                        <span>UNIBRA</span>
                    </footer>
                </main>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container py-5">
            @Body
        </div>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool menuUsuarioAberto;
    private bool menuRecolhido;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += AoNavegar;
    }

    private void AlternarMenu()
    {
        menuRecolhido = !menuRecolhido;
    }

    private void AlternarMenuUsuario()
    {
        menuUsuarioAberto = !menuUsuarioAberto;
    }

    private void FecharMenuUsuario()
    {
        menuUsuarioAberto = false;
    }

    private void AoNavegar(object? sender, LocationChangedEventArgs e)
    {
        menuUsuarioAberto = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= AoNavegar;
    }
}